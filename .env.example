NODE_ENV=development
PORT=4000

# Matches docker-compose.yml's postgres service (host port 5433 to avoid
# clashing with any other local Postgres already using 5432).
# Only used when running the app directly on the host (npm run dev/start);
# under `docker compose up`, the app container talks to postgres over the
# compose network instead (see POSTGRES_* below and docker-compose.yml).
DATABASE_URL=postgres://voice_analyzer:voice_analyzer@localhost:5433/voice_analyzer

# Set to true only when DATABASE_URL points at a managed/hosted Postgres that
# requires SSL (e.g. RDS, Supabase, Render). Leave false for the bundled
# docker-compose Postgres, which doesn't speak SSL.
DB_SSL=false

# Credentials for docker-compose.yml's postgres service. Change these before
# deploying anywhere beyond your own machine.
POSTGRES_USER=voice_analyzer
POSTGRES_PASSWORD=voice_analyzer
POSTGRES_DB=voice_analyzer

# Generate with: openssl rand -base64 48
JWT_SECRET=

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://hortencia-levitative-sordidly.ngrok-free.dev

# Used only by `npm run seed` to create the very first admin account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=change-me-now
